<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/t_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/w_today"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_no_tasks"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/t_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/w_new_task"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_plus" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/t_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:id="@+id/t_row0"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check0"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:contentDescription="@string/w_toggle_task"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/t_dot0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/w_dot"
            android:textColor="#8364E8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_title0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_time0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row1"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:contentDescription="@string/w_toggle_task"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/t_dot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/w_dot"
            android:textColor="#8364E8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row2"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:contentDescription="@string/w_toggle_task"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/t_dot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/w_dot"
            android:textColor="#8364E8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row3"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:contentDescription="@string/w_toggle_task"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/t_dot3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/w_dot"
            android:textColor="#8364E8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row4"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/t_check4"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:contentDescription="@string/w_toggle_task"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/t_dot4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/w_dot"
            android:textColor="#8364E8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_title4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/t_time4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="@string/w_empty"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/t_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
