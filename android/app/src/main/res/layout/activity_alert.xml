<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/a_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#441C72"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/a_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="-24dp"
            android:layout_marginBottom="-24dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/a_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1"
            android:textColor="#D397FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/a_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Guided screen break: breathing circle with the countdown -->
        <FrameLayout
            android:id="@+id/a_breath_box"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <View
                android:id="@+id/a_ring_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/breath_ring_outer" />

            <View
                android:id="@+id/a_ring_inner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="28dp"
                android:background="@drawable/breath_ring_inner" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/a_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/a_breath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E6D9FF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/a_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="22dp"
            android:max="1000"
            android:progressDrawable="@drawable/widget_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/a_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/alert_steps_bg"
            android:lineSpacingExtra="8dp"
            android:padding="16dp"
            android:text="@string/alert_screen_steps"
            android:textColor="#F2EAFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/a_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/a_primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/alert_btn_primary"
            android:textAllCaps="false"
            android:textColor="#441C72"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/a_secondary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/alert_btn_ghost"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/a_tertiary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/alert_btn_ghost"
                android:text="@string/alert_skip"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/a_open"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/alert_open"
            android:textColor="#D397FA"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
