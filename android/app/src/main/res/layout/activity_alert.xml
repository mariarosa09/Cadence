<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#441C72" android:fitsSystemWindows="true" android:gravity="center" android:orientation="vertical" android:padding="28dp">
    <ImageView android:layout_width="160dp" android:layout_height="160dp" android:layout_marginBottom="-24dp" android:layout_marginTop="-24dp" android:importantForAccessibility="no" android:src="@mipmap/ic_launcher_foreground" android:scaleType="centerCrop" />
    <TextView android:id="@+id/a_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:letterSpacing="0.1" android:textColor="#D397FA" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/a_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/a_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:textSize="64sp" android:visibility="gone" />
    <TextView android:id="@+id/a_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="3dp" android:textColor="#D9FFFFFF" android:textSize="16sp" />
    <Button android:id="@+id/a_primary" android:layout_width="match_parent" android:layout_height="56dp" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="36dp" android:background="@drawable/alert_btn_primary" android:textColor="#441C72" />
    <Button android:id="@+id/a_secondary" android:layout_width="match_parent" android:layout_height="56dp" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="12dp" android:background="@drawable/alert_btn_ghost" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/a_open" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/alert_open" android:textColor="#D397FA" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
