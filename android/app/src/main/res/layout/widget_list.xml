    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" />
    <LinearLayout android:id="@+id/l_row0" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
